{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.codespar/mcp-nubank",
  "description": "DEPRECATED: no live endpoint (api.nubank.com.br does not resolve)",
  "repository": {
    "url": "https://github.com/codespar/mcp-dev-latam",
    "source": "github",
    "subfolder": "packages/payments/nubank"
  },
  "version": "0.2.0-alpha.4",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@codespar/mcp-nubank",
      "version": "0.2.0-alpha.4",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "NUBANK_CLIENT_ID",
          "description": "API key/token for nubank",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ],
  "provider": {
    "homepage": "https://www.nubank.com.br",
    "logoUrl": "https://logo.clearbit.com/nubank.com.br",
    "logoFallback": "https://www.google.com/s2/favicons?domain=nubank.com.br&sz=128",
    "sandbox": {
      "available": false
    },
    "docsUrl": "https://openfinancebrasil.org.br"
  }
}
