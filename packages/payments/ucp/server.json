{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.codespar/mcp-ucp",
  "description": "DEPRECATED: no live endpoint (UCP is a spec; commerce.googleapis.com serves no API)",
  "repository": {
    "url": "https://github.com/codespar/mcp-dev-latam",
    "source": "github",
    "subfolder": "packages/payments/ucp"
  },
  "version": "0.1.5",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@codespar/mcp-ucp",
      "version": "0.1.5",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "UCP_API_KEY",
          "description": "API key for ucp",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ],
  "provider": {
    "homepage": "https://www.google.com",
    "logoUrl": "https://logo.clearbit.com/google.com",
    "logoFallback": "https://www.google.com/s2/favicons?domain=google.com&sz=128",
    "sandbox": {
      "available": false
    }
  }
}
